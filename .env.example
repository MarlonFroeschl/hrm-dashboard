# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://hrm:hrm_password@localhost:5432/hrm
POSTGRES_DB=hrm
POSTGRES_USER=hrm
POSTGRES_PASSWORD=hrm_password

# ─── Auth ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-at-least-64-random-chars
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173

# ─── KI / Claude API ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── E-Mail ───────────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@hrm.local

# ─── Datei-Upload ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ─── App ──────────────────────────────────────────────────────────────────────
DEBUG=true

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ─── n8n Webhooks (extern, nicht in Docker) ───────────────────────────────────
N8N_WEBHOOK_NEW_APPLICANT=
N8N_WEBHOOK_ONBOARDING_START=
N8N_WEBHOOK_OFFBOARDING_START=
N8N_WEBHOOK_EMPLOYEE_UPDATED=
